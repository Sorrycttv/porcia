<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/nutriplan_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Параметры рациона" android:textColor="@color/nutriplan_text" android:textSize="28sp" android:textStyle="bold" style="@style/Porcia.Title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Рекомендация носит информационный характер и не заменяет консультацию врача." android:textColor="@color/nutriplan_muted" android:textSize="14sp" style="@style/Porcia.Subtitle" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp" style="@style/Porcia.Card">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="О тебе" android:layout_marginTop="0dp" style="@style/Porcia.Section" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Пол" android:textColor="@color/nutriplan_text" android:textSize="15sp" />
            <Spinner android:id="@+id/sexSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:background="@drawable/porcia_spinner" android:paddingStart="12dp" android:paddingEnd="40dp" />
            <EditText android:id="@+id/ageInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Возраст, лет" android:inputType="number" style="@style/Porcia.Input" android:minHeight="56dp" />
            <EditText android:id="@+id/heightInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Рост, см" android:inputType="numberDecimal" style="@style/Porcia.Input" android:minHeight="56dp" />
            <EditText android:id="@+id/weightInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Вес, кг" android:inputType="numberDecimal" style="@style/Porcia.Input" android:minHeight="56dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Физическая активность" android:textColor="@color/nutriplan_text" android:textSize="15sp" />
            <Spinner android:id="@+id/activitySpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:background="@drawable/porcia_spinner" android:paddingStart="12dp" android:paddingEnd="40dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Цель" android:textColor="@color/nutriplan_text" android:textSize="15sp" />
            <Spinner android:id="@+id/goalSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:background="@drawable/porcia_spinner" android:paddingStart="12dp" android:paddingEnd="40dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp" style="@style/Porcia.Card">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Предпочтения и ограничения" android:layout_marginTop="0dp" style="@style/Porcia.Section" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Исключить аллергены" android:textColor="@color/nutriplan_text" android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/allergenOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Фильтр учитывает состав рецептов. Состав покупаемых продуктов проверяйте на упаковке." android:textColor="@color/nutriplan_muted" android:textSize="14sp" style="@style/Porcia.Subtitle" />
            <EditText android:id="@+id/restrictionsInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Другие исключения через запятую: курица, рис, помидоры" android:inputType="textCapSentences|textMultiLine" android:minHeight="80dp" android:gravity="top" android:padding="12dp" style="@style/Porcia.Input" />
            <EditText android:id="@+id/preferredFoodsInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Предпочитаемая пища" android:inputType="textCapSentences|textMultiLine" android:minHeight="80dp" android:gravity="top" android:padding="12dp" style="@style/Porcia.Input" />
            <EditText android:id="@+id/budgetInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Бюджет на месяц, ₽" android:inputType="numberDecimal" style="@style/Porcia.Input" android:minHeight="56dp" />
        </LinearLayout>
        <Button android:id="@+id/saveProfileButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:backgroundTint="@color/nutriplan_green" android:text="Сохранить профиль" android:textColor="@color/nutriplan_on_primary" android:textSize="16sp" style="@style/Porcia.Button" android:minHeight="56dp" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>