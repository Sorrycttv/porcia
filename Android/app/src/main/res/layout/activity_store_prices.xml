<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/nutriplan_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Цены рядом" android:textColor="@color/nutriplan_text" android:textSize="28sp" android:textStyle="bold" style="@style/Porcia.Title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Домашняя нейросеть подберёт товары для рациона из каталога «Верного» и сайта «Магнита». Выберите регион. Цены доставки могут отличаться от ценников в магазине." android:textColor="@color/nutriplan_muted" android:textSize="15sp" style="@style/Porcia.Subtitle" />
        <LinearLayout style="@style/Porcia.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
            <TextView style="@style/Porcia.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Товары для твоего меню" />
            <Spinner android:id="@+id/storeRegionSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="56dp" android:background="@drawable/porcia_input" android:paddingStart="12dp" android:paddingEnd="12dp" />
            <Button android:id="@+id/openMagnitWebsiteButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Выбрать адрес доставки на сайте Магнита" android:textAllCaps="false" style="@style/Porcia.Button.Secondary" android:minHeight="56dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Для цен «Магнита» выберите адрес доставки на сайте, откройте товар и вставьте его ссылку ниже. Без ссылки доступен каталог «Верного»." android:textColor="@color/nutriplan_muted" style="@style/Porcia.Subtitle" />
            <EditText android:id="@+id/magnitStoreLinkInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:hint="Ссылка на товар выбранного Магнита" android:inputType="textUri" android:maxLines="2" android:textColor="@color/nutriplan_text" android:textColorHint="@color/nutriplan_hint" style="@style/Porcia.Input" />
            <CheckBox android:id="@+id/refreshStorePricesCheckBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Обновить цены при следующем поиске" android:textColor="@color/nutriplan_text" android:minHeight="48dp" />
            <Button android:id="@+id/findPlanProductsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="Подобрать товары для рациона с ИИ" android:textAllCaps="false" android:textColor="@color/nutriplan_on_primary" android:backgroundTint="@color/nutriplan_green" style="@style/Porcia.Button" />
        </LinearLayout>
        <Button android:id="@+id/openStoreMapButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:text="Магазины на карте и пеший маршрут" android:textAllCaps="false" style="@style/Porcia.Button.Secondary" />
        <LinearLayout style="@style/Porcia.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
            <TextView style="@style/Porcia.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Найти отдельный продукт" />
            <EditText android:id="@+id/storeProductInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="Продукт, например молоко" android:inputType="textCapSentences" android:maxLines="1" android:padding="12dp" android:textColor="@color/nutriplan_text" android:textColorHint="@color/nutriplan_hint" style="@style/Porcia.Input" android:minHeight="56dp" />
            <Button android:id="@+id/compareStorePricesButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Найти продукт и магазины рядом" android:textAllCaps="false" android:textSize="17sp" style="@style/Porcia.Button.Secondary" android:minHeight="56dp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/storePricesProgress" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:layout_marginTop="12dp" android:visibility="gone" />
        <TextView android:id="@+id/storePricesResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:autoLink="web" android:textIsSelectable="true" android:textColor="@color/nutriplan_text" android:textSize="16sp" />
    </LinearLayout>
</ScrollView>