<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="@color/nutriplan_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/coach_title" android:textColor="@color/nutriplan_text" android:textSize="28sp" android:textStyle="bold" style="@style/Porcia.Title" />
        <Button android:id="@+id/clearCoachHistoryButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="56dp" android:minWidth="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="Очистить" android:textAllCaps="false" android:textSize="13sp" style="@style/Porcia.Button.Secondary" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Спросите о рационе, покупках, замене продуктов или использовании остатков." android:textColor="@color/nutriplan_muted" android:textSize="15sp" style="@style/Porcia.Subtitle" />
    <ScrollView android:id="@+id/coachAnswerScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="16dp" android:fillViewport="true">
        <LinearLayout android:id="@+id/coachMessagesContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="8dp" />
    </ScrollView>
    <EditText android:id="@+id/coachQuestionInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Введите вопрос" android:textColorHint="@color/nutriplan_hint" android:inputType="textCapSentences|textMultiLine" android:maxLines="4" android:minHeight="56dp" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" android:paddingBottom="12dp" android:textColor="@color/nutriplan_text" style="@style/Porcia.Input" />
    <ProgressBar android:id="@+id/coachProgressBar" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:layout_marginTop="8dp" android:visibility="gone" />
    <Button android:id="@+id/sendCoachButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:backgroundTint="@color/nutriplan_green" android:text="Спросить коуча" android:textAllCaps="false" android:textColor="@color/nutriplan_on_primary" android:textSize="17sp" style="@style/Porcia.Button" android:minHeight="56dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="Ответы носят информационный характер" android:textColor="@color/nutriplan_hint" android:textSize="12sp" />
</LinearLayout>