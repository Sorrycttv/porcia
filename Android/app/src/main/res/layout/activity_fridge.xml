<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/nutriplan_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Мой холодильник" android:textColor="@color/nutriplan_text" android:textSize="28sp" android:textStyle="bold" style="@style/Porcia.Title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Укажите каждый продукт с новой строки, например: рис 0,5 кг. Количество можно писать до или после названия. Чтобы очистить запас, удалите все строки и сохраните." android:textColor="@color/nutriplan_muted" android:textSize="16sp" style="@style/Porcia.Subtitle" />
        <LinearLayout style="@style/Porcia.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
            <TextView style="@style/Porcia.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Что уже есть дома" />
            <EditText android:id="@+id/fridgeInput" android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="18dp" android:gravity="top|start" android:hint="Куриное филе 500 г&#10;1 кг картофеля&#10;Рис: 300 г" android:inputType="textMultiLine|textCapSentences" android:padding="12dp" style="@style/Porcia.Input" />
            <Button android:id="@+id/saveFridgeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:backgroundTint="@color/nutriplan_green" android:text="Сохранить продукты" android:textAllCaps="false" android:textColor="@color/nutriplan_on_primary" style="@style/Porcia.Button" android:minHeight="56dp" />
        </LinearLayout>
        <Button android:id="@+id/fridgeRecommendationsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Что можно приготовить" android:textAllCaps="false" style="@style/Porcia.Button.Secondary" android:minHeight="56dp" />
        <ProgressBar android:id="@+id/fridgeProgress" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:layout_marginTop="18dp" android:visibility="gone" />
        <TextView android:id="@+id/fridgeResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textColor="@color/nutriplan_text" android:textSize="16sp" />
    </LinearLayout>
</ScrollView>